# Fyers automation secrets. Copy to deploy/fyers.env on the VPS, fill in,
# and lock it down:  chmod 600 deploy/fyers.env
# This file is git-ignored. NEVER commit it or paste these values anywhere.

# From the Fyers API dashboard (your app):
FYERS_APP_ID=YOURAPPID-100
FYERS_SECRET_ID=your-app-secret
FYERS_REDIRECT_URI=https://127.0.0.1/

# Your Fyers login, for automated daily token generation:
FYERS_FY_ID=XF12345              # your login id
FYERS_PIN=1234                   # your 4-digit app PIN
FYERS_TOTP_SECRET=ABCD...        # the 2FA seed shown when you set up the authenticator

# Allow the runner to log in by itself:
FYERS_AUTO_LOGIN=1
