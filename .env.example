# Copy to .env and fill in on the machine that runs live data (e.g. your VPS).
# NEVER commit the real .env or paste these values into chat or code.
# .env is already git-ignored.

FYERS_APP_ID=YOURAPPID-100
FYERS_ACCESS_TOKEN=paste-todays-token-here

# Only needed to generate the daily token (marketscan.brokers.fyers_auth):
FYERS_SECRET_ID=your-app-secret
FYERS_REDIRECT_URI=https://127.0.0.1/
